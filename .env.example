# RastroJuliaca — configuración por variables de entorno (prefijo RJ_)
# Copie este archivo como .env (scripts/setup.ps1 lo hace y genera un secreto aleatorio).

# development | test | production  (en production se exige RJ_SECRET_KEY propia)
RJ_ENV=development
# Modo demostración: muestra avisos y carga datos ficticios en una BD vacía
RJ_DEMO_MODE=true
# Secreto para HMAC de sesiones y seudónimos. Genérelo con: python -c "import secrets;print(secrets.token_urlsafe(48))"
RJ_SECRET_KEY=cambie-este-valor

# Base de datos (SQLite para el MVP; compatible con PostgreSQL vía SQLAlchemy, p. ej.
# postgresql+psycopg://usuario:clave@127.0.0.1:5432/rastrojuliaca  — requiere instalar el controlador)
# RJ_DATABASE_URL=sqlite:///C:/ruta/al/proyecto/data/rastrojuliaca.db
# RJ_STORAGE_DIR=C:/ruta/al/proyecto/data/storage

# Sesiones
RJ_SESSION_HOURS=8
# Use true únicamente si sirve la aplicación por HTTPS
RJ_COOKIE_SECURE=false

# Límites de carga (MB)
RJ_MAX_IMAGE_MB=15
RJ_MAX_VIDEO_MB=200
RJ_MAX_DOCUMENT_MB=20

# Antivirus: auto | defender | clamav | none   (none = los archivos quedan bloqueados)
RJ_AV_ENGINE=auto
RJ_AV_TIMEOUT_S=180

# Multimedia (vacío = buscar en PATH)
RJ_FFMPEG_PATH=
RJ_FFPROBE_PATH=
RJ_MEDIA_TIMEOUT_S=240
RJ_MAX_VIDEO_SECONDS=900
RJ_MEDIA_THREADS=2

# Rate limiting: solicitudes por ventana (segundos)
RJ_RATE_LOGIN=10
RJ_RATE_REGISTER=5
RJ_RATE_UPLOAD=30
RJ_RATE_EXPORT=30
RJ_RATE_WINDOW_S=300
