# ---------------------------------------------------------------
# Datos locales: BD SQLite, almacenamiento de archivos (subidos,
# cuarentena, almacén, copias de reproducción), medios sintéticos.
# ---------------------------------------------------------------
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
storage/
quarantine/
vault/
playback/

# Conjuntos experimentales generados y resultados con observaciones de participantes
experiment/conjuntos/
experiment/resultados/

# Secretos y configuración local (se conserva .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# Registros
*.log
logs/

# Python: entornos virtuales (cualquier nombre: .venv, .venv_alt, venv…)
.venv*/
venv*/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Herramientas locales del editor / asistentes
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
